# Copy to .env and fill in. Never commit real secrets.

# Local chat (also accepted as fallback)
PLATFORM_API_KEY=
PLATFORM_BASE_URL=https://api.openai.com/v1
PLATFORM_MODEL=qwen3.8-27b-noreason
PLATFORM_SSL_VERIFY=true

# Platform auto-eval (set by organizers; preferred when present)
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=
# GEN_MODEL=
# TEMPERATURE=0
# MAX_TOKENS=512
# DATA_DIR=data

# --- Embeddings / rerank ---
# Platform contract (when LLM_* set, no EMB_URL): model BAAI/bge-m3 on same host.
# Local index build (Timeweb etc.): dedicated emb host — preferred when both set.
# EMB_URL=https://api.timeweb.ai/v1
# EMB_KEY=
# EMB_MODEL=timeweb/bge-m3
# Optional rerank (defaults to EMB_URL/rerank or LLM host /rerank):
# RERANK_URL=
# RERANK_MODEL=timeweb/bge-reranker-v2-m3
# On platform (no EMB_*): BAAI/bge-m3 + qwen3-reranker-8b via LLM_* host.
# PLATFORM_RERANK=auto
# PLATFORM_RERANK_URL=
# PLATFORM_RERANK_MODEL=qwen3-reranker-8b
#
# Precompute doc index (pack includes .npy if present):
#   python3 -u scripts/embed_index.py
#   python3 -u scripts/smoke_dense.py

# Подключение к PostgreSQL (в docker-compose сервис называется db)
DB_USER=postgres
DB_PASSWORD=change_me
DB_HOST=db
DB_PORT=5432
DB_NAME=clinical_recommendations

# Минздрав API (артефакты с изначального репозитория)
MINZDRAV_URL=https://apicr.minzdrav.gov.ru/api.ashx
ORIGIN=https://apicr.minzdrav.gov.ru
REFERER=https://apicr.minzdrav.gov.ru/

# JWT-секрет (обязательно задайте свой, например: openssl rand -hex 32)
JWT_SECRET=change_me_to_random_secret

# Протокол backend: https (самоподписанные сертификаты из certs/) или http (для Docker)
BACKEND_SCHEME=http
